{
  "name": "@netdollar/emdash-forms",
  "version": "0.1.0",
  "description": "Show EmDash Forms on your site: the Form content block, <Form> Astro component and /forms/<id> pages.",
  "license": "MIT",
  "author": "Charl Kruger (https://netdollar.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charl-kruger/emdash-forms.git",
    "directory": "packages/forms-ui"
  },
  "homepage": "https://github.com/charl-kruger/emdash-forms#readme",
  "keywords": [
    "emdash",
    "emdash-plugin",
    "astro",
    "forms",
    "contact-form"
  ],
  "type": "module",
  "files": [
    "dist",
    "src/astro",
    "src/styles.css",
    "bin-dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": "./src/astro/index.js",
    "./Form": "./src/astro/Form.astro"
  },
  "bin": {
    "emdash-forms": "./bin-dist/setup.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node build.mjs && tsc -p tsconfig.bin.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.5.4",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "emdash": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "astro": "7.3.5",
    "@types/node": "26.6.3",
    "@emdash-forms/engine": "workspace:*",
    "esbuild": "^0.25.0"
  }
}
