  "peerDependencies": {
    "emdash": "0.42.x",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "^19.0.0"
  },
  "bin": {
