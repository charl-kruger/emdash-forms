{
  "name": "@emdash-forms/plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": { "#zod": "zod/mini" },
  "files": [
    "dist",
    "src",
    "bin",
    "bin-dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./astro": "./src/astro/index.ts",
    "./Form": "./src/astro/Form.astro",
    "./admin": "./src/admin.tsx",
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.contracts.json && tsc -p tsconfig.build.json && node build.mjs && tsc -p tsconfig.bin.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "zod": "4.5.4",
    "typescript": "5.9.3",
    "@cloudflare/kumo": "2.6.0"
  },
  "peerDependencies": {
    "emdash": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "^19.0.0",
    "astro": "7.3.5",
    "@types/node": "26.6.3",
    "@emdash-forms/engine": "workspace:*",
    "esbuild": "^0.25.0"
  },
  "bin": {
    "emdash-forms": "./bin-dist/setup.js"
  }
}
