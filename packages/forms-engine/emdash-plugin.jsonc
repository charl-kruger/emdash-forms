{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "forms",
  "publisher": "did:plc:zfm2t2bsxltpu44kc7g3eyn4",
  "license": "MIT",
  "repo": "https://github.com/charl-kruger/emdash-forms",
  "author": {
    "name": "Charl Kruger",
    "url": "https://netdollar.dev"
  },
  "security": {
    "email": "security@netdollar.dev"
  },
  "name": "Forms",
  "description": "Contact forms, surveys and multi-step forms for EmDash with conditional logic, entry management, CSV export and email notifications.",
  "keywords": ["forms", "contact form", "form builder", "surveys", "submissions"],
  "sections": {
    "description": "Build contact forms, surveys and multi-step applications from the EmDash admin. Add fields, choices, required rules, conditional logic and calculations. Publish when ready, collect responses with spam protection, get email notifications, and read, star, annotate or export responses as CSV. A dashboard widget shows what's new, and MCP tools let AI agents manage forms and responses.",
    "installation": "1. Install Forms from the registry and open Plugins > Forms to create your first form.\n2. To show forms on your site, install the Forms Studio companion once per site (pnpm add @emdash-forms/ui, then run the installer shown on any form's Embed tab), then build and deploy.\n3. Insert the Form block in the content editor, or use <Form formId=\"...\" /> in an Astro template.\n\nEmail notifications need an email provider configured in EmDash.",
    "faq": "Why is a companion package needed to show forms on pages?\nEmDash runs registry plugins in a secure sandbox that can't add HTML or scripts to your pages. Forms Studio renders your forms on the site. You install it once, and every form you publish then works without another deploy.\n\nCan I use my own front end?\nYes. Each form's Embed tab documents the JSON API: fetch the definition, request a ticket, and submit."
  },
  "capabilities": [
    "email:send"
  ],
  "allowedHosts": [],
  "admin": {
    "pages": [{ "path": "/forms", "label": "Forms", "icon": "notepad" }],
    "widgets": [{ "id": "recent-responses", "title": "Form responses", "size": "half" }]
  },
  "storage": {
    "forms": {
      "indexes": [
        "status",
        "updatedAt"
      ]
    },
    "entries": {
      "indexes": [
        "formId",
        "createdAt",
        "status",
        [
          "formId",
          "createdAt"
        ],
        [
          "formId",
          "status"
        ]
      ]
    },
    "tickets": {
      "indexes": [
        "expiresAt"
      ]
    }
  }
}
