{
  "name": "@emdash-forms/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "imports": {
    "#zod": "zod/mini"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./sandbox": "./dist/plugin.mjs",
    "./runtime": "./src/plugin.ts",
    "./schema": "./src/schema.ts",
    "./templates": "./src/templates.ts"
  },
  "files": [
    "dist",
    "emdash-plugin.jsonc",
    "src/schema.ts",
    "src/templates.ts"
  ],
  "scripts": {
    "validate": "emdash-plugin validate",
    "build": "emdash-plugin build",
    "dev": "emdash-plugin dev",
    "typecheck": "tsc --noEmit",
    "test": "emdash-plugin validate && vitest run",
    "bundle": "emdash-plugin bundle",
    "login": "emdash-plugin login",
    "release:setup": "emdash-plugin release setup",
    "release": "emdash-plugin publish"
  },
  "peerDependencies": {
    "emdash": "^1.0.0"
  },
  "devDependencies": {
    "@emdash-cms/plugin-cli": "0.13.1",
    "@emdash-cms/plugin-test": "0.2.6",
    "emdash": "1.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@emdash-cms/blocks": "1.0.1"
  },
  "dependencies": {
    "zod": "4.5.4"
  }
}
